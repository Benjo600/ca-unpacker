# Supabase project (local CLI + Edge Function secrets)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_ALLOWED_EMAILS=you@example.com,friend@example.com

# Netlify site for apps/web (signup/login/admin SPA)
# Set in Netlify UI: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Desktop / PyInstaller build — public auth web URL (deployed Netlify apps/web URL)
CA_UNPACKER_AUTH_URL=https://ca-unpacker-auth.netlify.app

# Edge Functions (production): npx supabase functions deploy check-quota record-usage heartbeat admin-list-orgs admin-update-plan
